{
  "info": {
    "name": "Silvee925 ERP Backend - Phase 1",
    "description": "Authentication, User/Employee management, and Company Master APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "companyId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register first ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) { pm.collectionVariables.set('accessToken', body.data.accessToken); pm.collectionVariables.set('refreshToken', body.data.refreshToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Super Admin\",\n  \"email\": \"admin@silvee925.com\",\n  \"password\": \"Admin@12345\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) { pm.collectionVariables.set('accessToken', body.data.accessToken); pm.collectionVariables.set('refreshToken', body.data.refreshToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@silvee925.com\",\n  \"password\": \"Admin@12345\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) { pm.collectionVariables.set('accessToken', body.data.accessToken); pm.collectionVariables.set('refreshToken', body.data.refreshToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh-token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "User Management (ADMIN only)",
      "item": [
        {
          "name": "Create Employee + SALES Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) { pm.collectionVariables.set('userId', body.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users/employees",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeCode\": \"SM-001\",\n  \"fullName\": \"Mahesh Patil\",\n  \"designation\": \"Salesman\",\n  \"phone\": \"+91 98765 43210\",\n  \"email\": \"mahesh@silvee925.com\",\n  \"password\": \"Sales@12345\",\n  \"permissions\": [\n    { \"module\": \"CUSTOMER_MASTER\", \"action\": \"READ\" },\n    { \"module\": \"SALES_INVOICE\", \"action\": \"CREATE\" },\n    { \"module\": \"SALES_INVOICE\", \"action\": \"READ\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Assign Permissions",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/users/{{userId}}/permissions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\n    { \"module\": \"CUSTOMER_MASTER\", \"action\": \"READ\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/{{userId}}/deactivate"
          }
        },
        {
          "name": "Activate User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/{{userId}}/activate"
          }
        }
      ]
    },
    {
      "name": "Company Master",
      "item": [
        {
          "name": "Create Company",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) { pm.collectionVariables.set('companyId', body.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/masters/companies",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyCode\": \"SILVEE925\",\n  \"companyName\": \"Silvee925 Jewels Pvt. Ltd.\",\n  \"legalName\": \"Silvee925 Jewels Private Limited\",\n  \"companyType\": \"Private Limited\",\n  \"gstNo\": \"27ABCDE1234F1Z5\",\n  \"panNo\": \"ABCDE1234F\",\n  \"phone\": \"+91 88888 92525\",\n  \"email\": \"info@silvee925.com\",\n  \"website\": \"www.silvee925.com\",\n  \"addressLine1\": \"3A, 3B, 2nd Floor, SB Road\",\n  \"city\": \"Pune\",\n  \"state\": \"Maharashtra\",\n  \"stateCode\": \"27\",\n  \"pincode\": \"411016\",\n  \"country\": \"India\",\n  \"currency\": \"INR\",\n  \"defaultCompany\": false,\n  \"status\": \"ACTIVE\"\n}"
            }
          }
        },
        {
          "name": "Update Company",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/masters/companies/{{companyId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyCode\": \"SILVEE925\",\n  \"companyName\": \"Silvee925 Jewels Pvt. Ltd. (Updated)\",\n  \"phone\": \"+91 88888 92525\",\n  \"state\": \"Maharashtra\",\n  \"stateCode\": \"27\",\n  \"country\": \"India\",\n  \"currency\": \"INR\",\n  \"defaultCompany\": true,\n  \"status\": \"ACTIVE\"\n}"
            }
          }
        },
        {
          "name": "Get Company",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/masters/companies/{{companyId}}"
          }
        },
        {
          "name": "Search Companies (paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/masters/companies?query=silvee&status=ACTIVE&page=0&size=10&sort=companyName,asc",
              "host": ["{{baseUrl}}"],
              "path": ["masters", "companies"],
              "query": [
                { "key": "query", "value": "silvee" },
                { "key": "status", "value": "ACTIVE" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "companyName,asc" }
              ]
            }
          }
        },
        {
          "name": "Set Default Company",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/masters/companies/{{companyId}}/set-default"
          }
        },
        {
          "name": "Delete Company",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/masters/companies/{{companyId}}"
          }
        }
      ]
    },
